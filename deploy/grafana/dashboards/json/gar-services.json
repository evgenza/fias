{
  "uid": "gar-services",
  "title": "GAR Platform — Сервисы",
  "description": "RED-метрики и рантайм Go-сервисов платформы (importer, indexer, suggester, address-api)",
  "tags": ["gar", "platform", "services"],
  "timezone": "",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {"from": "now-1h", "to": "now"},
  "schemaVersion": 39,
  "version": 1,
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Сервис",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "query": {"query": "label_values(go_goroutines{job=~\"importer|indexer|suggester|address-api\"}, service)", "refId": "StandardVariableQuery"},
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "sort": 1,
        "current": {"selected": true, "text": ["All"], "value": ["$__all"]}
      }
    ]
  },
  "annotations": {"list": []},
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Статус ($service)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 4, "w": 24, "x": 0, "y": 0},
      "targets": [
        {"refId": "A", "expr": "up{job=~\"$service\"}", "legendFormat": "{{job}}", "instant": true}
      ],
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "space-around", "orientation": "horizontal", "textMode": "value_and_name"},
      "fieldConfig": {
        "defaults": {"mappings": [{"type": "value", "options": {"1": {"text": "UP", "color": "green"}, "0": {"text": "DOWN", "color": "red"}}}], "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}},
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP RPS",
      "description": "rate(platform_http_requests_total) по path и code (middleware есть у address-api)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "targets": [
        {"refId": "A", "expr": "sum by (service, path, code) (rate(platform_http_requests_total{service=~\"$service\"}[10m]))", "legendFormat": "{{service}} {{path}} {{code}}"}
      ],
      "options": {"legend": {"displayMode": "table", "placement": "right", "calcs": ["sum"]}, "tooltip": {"mode": "multi"}},
      "fieldConfig": {"defaults": {"unit": "reqps", "min": 0, "custom": {"drawStyle": "line", "fillOpacity": 10, "showPoints": "never"}}, "overrides": []}
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "gRPC RPS",
      "description": "rate(grpc_requests_total) по method и code (suggester)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "targets": [
        {"refId": "A", "expr": "sum by (service, method, code) (rate(grpc_requests_total{service=~\"$service\"}[10m]))", "legendFormat": "{{service}} {{method}} {{code}}"}
      ],
      "options": {"legend": {"displayMode": "table", "placement": "right", "calcs": ["sum"]}, "tooltip": {"mode": "multi"}},
      "fieldConfig": {"defaults": {"unit": "reqps", "min": 0, "custom": {"drawStyle": "line", "fillOpacity": 10, "showPoints": "never"}}, "overrides": []}
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "HTTP latency p95 / p50",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
      "targets": [
        {"refId": "A", "expr": "histogram_quantile(0.95, sum by (le, service) (rate(platform_http_request_duration_seconds_bucket{service=~\"$service\"}[10m])))", "legendFormat": "p95 {{service}}"},
        {"refId": "B", "expr": "histogram_quantile(0.5, sum by (le, service) (rate(platform_http_request_duration_seconds_bucket{service=~\"$service\"}[10m])))", "legendFormat": "p50 {{service}}"}
      ],
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "fieldConfig": {"defaults": {"unit": "s", "min": 0, "custom": {"drawStyle": "line", "fillOpacity": 10, "showPoints": "never"}}, "overrides": []}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "gRPC latency p95 / p50",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
      "targets": [
        {"refId": "A", "expr": "histogram_quantile(0.95, sum by (le, method) (rate(grpc_request_duration_seconds_bucket{service=~\"$service\"}[10m])))", "legendFormat": "p95 {{method}}"},
        {"refId": "B", "expr": "histogram_quantile(0.5, sum by (le, method) (rate(grpc_request_duration_seconds_bucket{service=~\"$service\"}[10m])))", "legendFormat": "p50 {{method}}"}
      ],
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "fieldConfig": {"defaults": {"unit": "s", "min": 0, "custom": {"drawStyle": "line", "fillOpacity": 10, "showPoints": "never"}}, "overrides": []}
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "HTTP 5xx rate",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 20},
      "targets": [
        {"refId": "A", "expr": "sum by (service, path) (rate(platform_http_requests_total{service=~\"$service\", code=~\"5..\"}[10m]))", "legendFormat": "{{service}} {{path}}"}
      ],
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "fieldConfig": {"defaults": {"unit": "reqps", "min": 0, "color": {"fixedColor": "red", "mode": "fixed"}, "custom": {"drawStyle": "line", "fillOpacity": 20, "showPoints": "never"}}, "overrides": []}
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Goroutines",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 20},
      "targets": [
        {"refId": "A", "expr": "go_goroutines{service=~\"$service\"}", "legendFormat": "{{service}}"}
      ],
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "fieldConfig": {"defaults": {"unit": "short", "min": 0, "custom": {"drawStyle": "line", "fillOpacity": 10, "showPoints": "never"}}, "overrides": []}
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Память (RSS)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 20},
      "targets": [
        {"refId": "A", "expr": "process_resident_memory_bytes{service=~\"$service\"}", "legendFormat": "{{service}}"}
      ],
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "fieldConfig": {"defaults": {"unit": "bytes", "min": 0, "custom": {"drawStyle": "line", "fillOpacity": 10, "showPoints": "never"}}, "overrides": []}
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "CPU",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 28},
      "targets": [
        {"refId": "A", "expr": "rate(process_cpu_seconds_total{service=~\"$service\"}[10m])", "legendFormat": "{{service}}"}
      ],
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "custom": {"drawStyle": "line", "fillOpacity": 10, "showPoints": "never"}}, "overrides": []}
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Бизнес-метрики сервисов",
      "description": "importer: записи/задачи; indexer: документы/события; address-api: подсказки/кэш",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 28},
      "targets": [
        {"refId": "A", "expr": "sum by (kind) (rate(gar_import_records_total{service=~\"$service\"}[10m]))", "legendFormat": "import {{kind}}"},
        {"refId": "B", "expr": "sum by (result) (rate(gar_worker_tasks_total{service=~\"$service\"}[10m]))", "legendFormat": "worker {{result}}"},
        {"refId": "C", "expr": "sum by (kind) (rate(indexer_documents_indexed_total{service=~\"$service\"}[10m]))", "legendFormat": "index {{kind}}"},
        {"refId": "D", "expr": "sum by (result) (rate(address_api_suggest_total{service=~\"$service\"}[10m]))", "legendFormat": "suggest {{result}}"},
        {"refId": "E", "expr": "sum by (result) (rate(address_cache_total{service=~\"$service\"}[10m]))", "legendFormat": "cache {{result}}"}
      ],
      "options": {"legend": {"displayMode": "table", "placement": "right", "calcs": ["sum"]}, "tooltip": {"mode": "multi"}},
      "fieldConfig": {"defaults": {"unit": "short", "min": 0, "custom": {"drawStyle": "line", "fillOpacity": 10, "showPoints": "never"}}, "overrides": []}
    }
  ]
}
